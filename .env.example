DATABASE_URL="postgresql://larogest:larogest@localhost:5432/larogest"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
SEED_EMAIL="admin@laro.pt"
SEED_PASSWORD="larogest123"
# Cloudflare Email Sending REST (Account → Email Sending → Edit).
# Both required in production. Leave both empty for next dev (writes storage/emails/).
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_EMAIL_API_TOKEN=""
# Cloudflare R2 (S3-compatible). Required in production for PDFs and care-report photos.
# Leave R2_* empty for next dev (writes storage/pdfs and storage/care-photos).
# Create an R2 API token with Object Read & Write on the bucket.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Optional. Defaults to CLOUDFLARE_ACCOUNT_ID and https://<account>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=""
R2_ENDPOINT=""
EMAIL_FROM="Laro <propostas@laro.pt>"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Pulse IoT — Tuya is the first adapter. Add others under src/lib/iot/.
TUYA_ACCESS_ID=""
TUYA_ACCESS_SECRET=""
TUYA_BASE_URL="https://openapi.tuyaeu.com"
TUYA_MESSAGE_ENV="prod"
# Não é o Access ID. É o UID da conta Smart Life ligada ao projecto
# (iot.tuya.com → Cloud → projecto → Devices → Link Tuya App Account → coluna UID, começa por ay…).
# Opcional se já existir um dispositivo Pulse ligado — o Pulse consegue ler o UID daí.
TUYA_UID=""
# Web Push no Laro Pulse (página /casa). Gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ola@laro.pt"
# iOS native push (Swift). Leave empty to skip APNs; PWA Web Push still works.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID=""
APNS_P8=""
APNS_PRODUCTION="false"
# Email da equipa Laro quando abre um alerta (opcional)
PULSE_ALERT_EMAIL=""
